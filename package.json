{
  "name": "soma-novel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "build:vite": "node scripts/build-seo-pages.mjs && vite build && node scripts/patch-built-homepage.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:next": "next build",
    "cf:build": "opennextjs-cloudflare build && npm run build:vite && node scripts/merge-vite-into-open-next.mjs",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:deploy-maintenance": "wrangler deploy --config wrangler.maintenance.jsonc",
    "start": "node dist/server.cjs",
    "start:next": "next start",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck:vite": "tsc -p tsconfig.vite.json --noEmit",
    "lint": "npm run typecheck:vite",
    "import:books": "node scripts/upload-soma-books.mjs",
    "seo:since": "node scripts/build-seo-pages.mjs --since",
    "test:incremental-deploy": "node --test scripts/tests/incremental-deployment.test.mjs scripts/tests/deployment-gates.test.mjs scripts/tests/seo-differential.test.mjs",
    "cf:data:preview": "node scripts/deploy-soma-site.mjs --target preview --data-only",
    "release:books": "node scripts/release-soma-books.mjs",
    "test:book-release": "node --test scripts/tests/soma-book-metadata.test.mjs scripts/tests/soma-book-release.test.mjs scripts/tests/static-reader-build.test.mjs scripts/tests/reader-static.test.mjs scripts/tests/cloudflare-static-asset-limits.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}