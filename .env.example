# Browser-safe Supabase configuration used by the Vite reader.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-anon-key"

# Browser-safe Supabase configuration used by Next.js pages.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-anon-key"

# Server-only secrets. Configure these as encrypted Cloudflare Worker secrets.
# Never prefix either value with VITE_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
INTERNAL_API_SECRET="generate-a-long-random-value"
RESEND_API_KEY="your-resend-api-key"
MONTHLY_REPORT_TO="reports@example.com"

# Optional local Express AI companion and one-off translation scripts.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash"
