{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somanovel.uk/schemas/story-meta.schema.json",
  "title": "Soma story metadata",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "title_original": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "enum": ["en", "sw", "English", "Swahili", "Kiswahili"] },
    "description": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["Romance", "Thriller", "Sci-Fi", "Historical", "Fantasy", "Contemporary", "Urban Fantasy"]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "translation_of_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  },
  "additionalProperties": true
}
